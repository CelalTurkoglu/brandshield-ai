# Sunucu tarafı entegrasyonları — değerleri istemci koduna koymayın.
# Apify bağlantısı yoksa dashboard açıkça Demo mode gösterir.
# APIFY_API_TOKEN=
# APIFY_REVIEW_ACTOR_ID=compass/google-maps-reviews-scraper
# FAL_KEY=
# FAL_MODEL=fal-ai/flux/schnell

# BrandShield local auth. Production’da güçlü ve benzersiz bir secret kullanın.
# Optional: production falls back to the platform-provided MANUS_JWT_SECRET as the session HMAC key.
# BRANDSHIELD_JWT_SECRET=

# Opsiyonel marka iletişim varsayılanları
# BRAND_MANAGER_WHATSAPP=https://wa.me/905555555555
# BRAND_MANAGER_EMAIL=care@yourbrand.com

# Managed MySQL database platform tarafından runtime’da sağlanır; local .env içine kopyalamayın.
# DATABASE_URL=
